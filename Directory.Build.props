<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      One version for every package this repo publishes — Tiki.Shared and all five gRPC
      contracts. They used to carry their own numbers (0.3.0, 0.2.0, 0.1.0, 0.2.3, ...) on the
      theory that each should release on its own cadence. In practice that meant six numbers to
      keep straight across five consuming repos, and consumers pinned combinations that had
      never existed: tiki-compliance-api asked for three contract versions that were never
      published, and tiki-integrations-api pinned Tiki.Shared 0.1.0 — two breaking releases
      behind what it was compiled against.
      One number removes the question "which contract version goes with which Tiki.Shared?"
      entirely, and the pipeline publishes them together, so it is always answerable by looking
      at one line. A package with no changes republishes as a no-op, via NuGet's skip-duplicate.
      Chosen to clear every version already published, so nothing collides with an immutable one.
    -->
    
    <TikiVersion>0.7.8</TikiVersion>

    <!-- Package metadata shared by every publishable project under src/ -->
    <Authors>Tiki Platform Team</Authors>
    <Company>Tiki</Company>
    <PackageProjectUrl>https://github.com/tiki/tiki-shared-lib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tiki/tiki-shared-lib</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!--
    grpc.tools does not ship a macosx_arm64 protoc/grpc_csharp_plugin build, so on
    Apple Silicon Macs without Rosetta 2 installed the bundled macosx_x64 binaries
    fail with "Bad CPU type in executable". Fall back to Homebrew's native arm64
    binaries (brew install protobuf grpc) when present. Mirrors the same fix in
    tiki-identity-api's Directory.Build.props, which doesn't apply here since this
    is a sibling repo, not a nested one.
  -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' and Exists('/opt/homebrew/bin/protoc') and Exists('/opt/homebrew/bin/grpc_csharp_plugin')">
    <PROTOBUF_PROTOC>/opt/homebrew/bin/protoc</PROTOBUF_PROTOC>
    <GRPC_PROTOC_PLUGIN>/opt/homebrew/bin/grpc_csharp_plugin</GRPC_PROTOC_PLUGIN>
  </PropertyGroup>

</Project>
