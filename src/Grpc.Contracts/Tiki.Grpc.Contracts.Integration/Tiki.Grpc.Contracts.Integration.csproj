<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Tiki.Grpc.Contracts.Integration</PackageId>
    <Version>0.2.2</Version>
    <Description>gRPC contract for Integration Service — provider-split protos (Veriff, Volume, SmartComply, and KYCAID). .proto-derived client stub and service base class.</Description>
    <PackageTags>tiki;grpc;contracts;integration</PackageTags>
    <RootNamespace>Tiki.Grpc.Contracts.Integration</RootNamespace>
    <AssemblyName>Tiki.Grpc.Contracts.Integration</AssemblyName>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>

    <!--
      Grpc.Tools-generated code isn't hand-reviewed the way the rest of this repo is, and
      trips analyzer/nullable warnings the root Directory.Build.props otherwise treats as
      errors. Relaxed here only, not repo-wide.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Consumer-facing dependencies only: Google.Protobuf for message types, Grpc.Core.Api
      for the generated stub/base class shapes. Never Grpc.Net.Client or Grpc.AspNetCore —
      this package must never force a transport choice on a consumer.
    -->
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
    <PackageReference Include="Grpc.Core.Api" Version="2.83.0" />

    <!-- Build-time codegen only — a development dependency, never flows to consumers. -->
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/*.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Ship the .proto itself as plain package content under protos/, not contentFiles —
      contentFiles gets fed straight to a consumer's own C# compiler on restore, which is
      never what we want for a file that exists to be read, not compiled, downstream.
      One file per provider (veriff.proto, later kycaid.proto, ...) so this package
      does not grow a single catch-all proto.
    -->
    <None Include="Protos/*.proto" Pack="true" PackagePath="protos" />
  </ItemGroup>

</Project>
