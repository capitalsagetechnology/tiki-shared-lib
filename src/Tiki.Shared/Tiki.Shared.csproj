<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      No vendor tracer, no broker framework, no database provider. The one deliberate
      exception is Persistence/, which references the base Microsoft.EntityFrameworkCore
      package (never a provider like Npgsql.EntityFrameworkCore.PostgreSQL) — it is
      consumed only from a service's own Infrastructure layer, never Domain/Application.
      See build-test.yml's disallowed-package check for what that boundary actually enforces.
    -->
    <IsPackable>true</IsPackable>
    <PackageId>Tiki.Shared</PackageId>
    <!-- Source of truth for release version — publish-shared.yml refuses to run unless a
         shared-v*.*.* tag's version matches this exactly. -->
    <Version>0.1.0</Version>
    <Description>Cross-cutting infrastructure shared by every Tiki microservice: caching, messaging (Kafka/Redpanda), telemetry (OpenTelemetry), gRPC service-token auth, Querydsl, Result&lt;T&gt;, and health checks. No domain logic, no EF Core, no messaging framework.</Description>
    <PackageTags>tiki;shared;infrastructure;kafka;redpanda;grpc;opentelemetry;querydsl</PackageTags>
    <RootNamespace>Tiki.Shared</RootNamespace>
    <AssemblyName>Tiki.Shared</AssemblyName>
  </PropertyGroup>

  <!--
    ASP.NET Core types (HttpContext, IMiddleware, ProblemDetails, IEndpointRouteBuilder,
    health check abstractions) via FrameworkReference — NOT the Web SDK. This project stays
    a plain class library so Application-layer code in any consuming service can reference
    it without pulling in a hosting model.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tiki.Shared.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Validation -->
    <PackageReference Include="FluentValidation" Version="12.1.1" />

    <!-- Telemetry -->
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.18.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />

    <!-- Caching -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />

    <!-- Messaging (Kafka via Redpanda, direct client — no framework) -->
    <PackageReference Include="Confluent.Kafka" Version="2.15.0" />

    <!-- gRPC -->
    <PackageReference Include="Grpc.Core.Api" Version="2.83.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.83.0" />

    <!-- Auth (JWKS validation for the real OAuth2 provider this interim HMAC one gets swapped for) -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />

    <!-- HealthChecks (hand-rolled against the driver directly — no extra health-check framework) -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.31" />

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.4.0" />

    <!-- Persistence (base package only — never a concrete database provider) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
  </ItemGroup>

</Project>
